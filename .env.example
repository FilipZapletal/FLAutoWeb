# --- Databáze (PostgreSQL) ---
# Lokálně: `npm run db:local` spustí Postgres na portu 5432
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/flauto"

# --- Web ---
# Veřejná adresa webu (canonical URL, Open Graph, sitemap)
SITE_URL="http://localhost:3000"

# --- Administrace ---
# Tajný klíč pro podpis přihlašovací cookie (min. 32 znaků), např. `openssl rand -base64 48`
SESSION_SECRET=""
# První admin se vytvoří seedem (`npm run db:seed`). Heslo min. 10 znaků. Po seedu lze z .env smazat.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# --- Úložiště fotek ---
# local = ukládá do ./uploads (vývoj), s3 = S3-kompatibilní úložiště (Supabase Storage, Cloudflare R2…)
STORAGE_DRIVER="local"
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Veřejná URL bucketu, např. https://<projekt>.supabase.co/storage/v1/object/public/<bucket>
S3_PUBLIC_URL=""

# --- E-maily (Resend) ---
# Bez RESEND_API_KEY se e-maily jen vypíší do konzole serveru.
RESEND_API_KEY=""
EMAIL_FROM="FL Auto <poptavky@example.com>"
# Kam chodí upozornění na nové poptávky
ADMIN_NOTIFY_EMAIL=""
