// FL Auto – databázové schéma (PostgreSQL)
// Změny schématu: `npm run db:migrate` (vytvoří migraci a aplikuje ji)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum VehicleStatus {
  DOSTUPNE
  REZERVOVANO
  PRODANO
  SKRYTE
}

enum Fuel {
  BENZIN
  DIESEL
  HYBRID
  PLUGIN_HYBRID
  ELEKTRO
  LPG_CNG
}

enum Transmission {
  MANUAL
  AUTOMAT
}

enum Drive {
  PREDNI
  ZADNI
  AWD
}

enum BodyType {
  HATCHBACK
  SEDAN
  KOMBI
  SUV
  MPV
  KUPE
  KABRIOLET
  UZITKOVE
}

enum EquipmentCategory {
  BEZPECNOST
  KOMFORT
  MULTIMEDIA
  EXTERIER
}

/// Připraveno na video a 360° prohlídku (fáze 2), zatím se používá jen IMAGE.
enum MediaType {
  IMAGE
  VIDEO
  PANO360
}

enum LeadType {
  INTEREST
  TEST_DRIVE
  RESERVATION
  FINANCING
  TRADE_IN
  CALLBACK
  SERVICE
  /// Zákazník hledá auto, které není v nabídce (formulář „Sehnat auto na přání“)
  WANTED_CAR
}

/// Preferovaná část dne pro servisní termín.
enum TimeSlot {
  DOPOLEDNE
  ODPOLEDNE
}

enum LeadStatus {
  NEW
  CONTACTED
  NEGOTIATION
  /// Jen u servisní objednávky: termín je domluvený (potvrzený termín je v confirmedDate)
  CONFIRMED
  RESERVED
  SOLD
  LOST
}

model Vehicle {
  id               Int           @id @default(autoincrement())
  brand            String
  model            String
  version          String?
  price            Int
  salePrice        Int?          @map("sale_price")
  /// Aktuální cena = sale_price ?? price. Udržuje ji aplikace, slouží pro filtr a řazení.
  currentPrice     Int           @map("current_price")
  year             Int
  registrationDate DateTime?     @map("registration_date") @db.Date
  mileage          Int
  fuel             Fuel
  transmission     Transmission
  drive            Drive?
  bodyType         BodyType      @map("body_type")
  /// Objem motoru v ccm
  engineVolume     Int?          @map("engine_volume")
  /// Výkon v kW
  power            Int?
  color            String?
  /// Celý VIN – veřejně se nikdy neposílá, jen maskovaný
  vin              String?
  /// Platnost STK (ukládá se první den měsíce)
  stk              DateTime?     @db.Date
  owners           Int?
  origin           String?
  consumption      String?
  emissions        String?
  seats            Int?
  doors            Int?
  description      String?       @db.Text
  status           VehicleStatus @default(DOSTUPNE)
  slug             String        @unique
  /// Staré slugy – při změně URL se z nich dělá 301 redirect
  previousSlugs    String[]      @default([]) @map("previous_slugs")
  featured         Boolean       @default(false)
  soldAt           DateTime?     @map("sold_at")
  archivedAt       DateTime?     @map("archived_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  images    VehicleImage[]
  equipment VehicleEquipment[]
  leads     Lead[]

  @@index([status, archivedAt])
  @@index([brand, model])
  @@index([currentPrice])
  @@index([year])
  @@index([mileage])
  @@map("vehicles")
}

model VehicleImage {
  id         Int       @id @default(autoincrement())
  vehicleId  Int       @map("vehicle_id")
  /// URL největší varianty (1920 px)
  url        String
  /// Základ klíče v úložišti; varianty jsou `${storageKey}-{400|1024|1920}.webp`
  storageKey String    @map("storage_key")
  width      Int
  height     Int
  alt        String?
  mediaType  MediaType @default(IMAGE) @map("media_type")
  sortOrder  Int       @default(0) @map("sort_order")
  isMain     Boolean   @default(false) @map("is_main")
  createdAt  DateTime  @default(now()) @map("created_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, sortOrder])
  @@map("vehicle_images")
}

model Equipment {
  id        Int               @id @default(autoincrement())
  name      String
  category  EquipmentCategory
  sortOrder Int               @default(0) @map("sort_order")

  vehicles VehicleEquipment[]

  @@unique([category, name])
  @@map("equipment")
}

model VehicleEquipment {
  vehicleId   Int @map("vehicle_id")
  equipmentId Int @map("equipment_id")

  vehicle   Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@id([vehicleId, equipmentId])
  @@map("vehicle_equipment")
}

model Lead {
  id            Int        @id @default(autoincrement())
  vehicleId     Int?       @map("vehicle_id")
  name          String
  phone         String
  email         String?
  type          LeadType
  message       String?    @db.Text
  status        LeadStatus @default(NEW)
  // Jen u servisní objednávky (type = SERVICE). Termín je přání zákazníka, admin ho potvrzuje telefonicky.
  car           String?
  serviceId     Int?       @map("service_id")
  preferredDate DateTime?  @map("preferred_date") @db.Date
  preferredSlot TimeSlot?  @map("preferred_slot")
  /// Termín domluvený majitelem (může se lišit od přání zákazníka). Je-li vyplněn, platí místo preferredDate.
  confirmedDate DateTime?  @map("confirmed_date") @db.Date
  confirmedSlot TimeSlot?  @map("confirmed_slot")
  /// Položky vybrané z ceníku služby (objednávka Crystal Finish): [{ label, price, from }]. Snapshot v době objednávky.
  items         Json       @default("[]")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  vehicle Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([type])
  @@index([type, preferredDate])
  @@index([type, confirmedDate])
  @@map("leads")
}

model Admin {
  id             Int      @id @default(autoincrement())
  email          String   @unique
  passwordHash   String   @map("password_hash")
  /// Zvýší se při změně hesla – všechna dříve vydaná přihlášení (cookies) tím přestanou platit.
  sessionVersion Int      @default(0) @map("session_version")
  createdAt      DateTime @default(now()) @map("created_at")

  pushSubscriptions PushSubscription[]

  @@map("admins")
}

/// Zařízení přihlášeného admina, kterému chodí upozornění na nové poptávky (Web Push).
/// Vzniká tlačítkem „Zapnout upozornění“ v administraci; neplatná zařízení se mažou při odesílání.
model PushSubscription {
  id        Int      @id @default(autoincrement())
  adminId   Int      @map("admin_id")
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@map("push_subscriptions")
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

enum ServiceIcon {
  CAR
  WRENCH
  SPARKLE
  SHIELD
}

/// Služba na stránce Servis – každá má vlastní stránku /servis/[slug].
model Service {
  id              Int         @id @default(autoincrement())
  title           String
  slug            String      @unique
  /// Staré slugy – při změně URL se z nich dělá 301 redirect
  previousSlugs   String[]    @default([]) @map("previous_slugs")
  /// Krátký štítek na kartě, např. „Dovoz na klíč“
  tag             String?
  icon            ServiceIcon @default(WRENCH)
  /// Krátký popis na kartě v přehledu
  summary         String
  /// Odrážky – co služba zahrnuje
  items           String[]    @default([])
  /// Delší text na stránce služby
  description     String?     @db.Text
  /// Ceník: [{ label, price, from, group?, note?, addon? }], cena v Kč; `from` = „od“,
  /// `group` = nadpis sekce, `note` = popisek pod položkou, `addon` = doplněk (nezapočítává se do ceny „od“)
  prices          Json        @default("[]")
  /// Poznámka k ceníku, např. „Ceny jsou včetně DPH.“
  priceNote       String?     @map("price_note")
  /// Vlastní kontakt služby (např. Crystal Finish). Je-li vyplněn, zobrazuje se na stránce služby
  /// jako jediný kontakt a online objednávka se pro službu nenabízí.
  contactPhone    String?     @map("contact_phone")
  /// Jméno k vlastnímu kontaktu služby, např. „Denis“
  contactName     String?     @map("contact_name")
  /// Zákazník si na stránce služby vybere položky z ceníku (objednávkový formulář místo obecného termínu)
  pickItems       Boolean     @default(false) @map("pick_items")
  metaTitle       String?     @map("meta_title")
  metaDescription String?     @map("meta_description")
  published       Boolean     @default(true)
  sortOrder       Int         @default(0) @map("sort_order")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  leads       Lead[]
  comparisons ServiceComparison[]

  @@index([published, sortOrder])
  @@map("services")
}

/// Fotky „před a po“ na stránce služby (např. Crystal Finish). Jen pro stránku služby – s vozy nemají nic společného.
model ServiceComparison {
  id        Int      @id @default(autoincrement())
  serviceId Int      @map("service_id")
  /// Krátký popisek, např. „Škoda Octavia – kompletní mytí a vosk“
  caption   String?
  /// Základ klíče v úložišti; varianty jako u fotek vozů (`-{400|1024|1920}.webp`)
  beforeKey String   @map("before_key")
  afterKey  String   @map("after_key")
  /// Rozměry fotky „před“ (určují poměr stran posuvníku)
  width     Int
  height    Int
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId, sortOrder])
  @@map("service_comparisons")
}

/// Recenze zákazníků – zadává je admin (např. přepisem z Googlu), na webu se zobrazují jen zvolené.
model Review {
  id            Int      @id @default(autoincrement())
  author        String
  text          String   @db.Text
  /// Počet hvězd 1–5
  rating        Int
  /// Odkud recenze pochází, např. „Google“
  source        String?
  showOnHome    Boolean  @default(true) @map("show_on_home")
  showOnService Boolean  @default(false) @map("show_on_service")
  sortOrder     Int      @default(0) @map("sort_order")
  /// Na webu se zobrazí jen schválená recenze. Recenze zadané adminem jsou schválené hned,
  /// recenze od návštěvníků čekají na schválení.
  approved      Boolean  @default(true)
  /// Napsal ji návštěvník přes formulář na webu
  fromCustomer  Boolean  @default(false) @map("from_customer")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([sortOrder])
  @@index([approved])
  @@map("reviews")
}

/// Anonymní statistika návštěvnosti (bez cookies, bez ukládání IP adresy).
/// `visitor` je jednodenní anonymní otisk (HMAC s klíčem platným jen pro daný den), z něhož nejde zjistit IP ani sledovat člověka přes více dnů.
model AnalyticsEvent {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  visitor   String
  /// "view" = zobrazení stránky, "action" = akce (zavolání, WhatsApp, odeslaná poptávka…)
  kind      String
  /// Cesta stránky (view) nebo název akce (action)
  name      String
  /// Cesta stránky, na které se to stalo (bez parametrů)
  path      String
  /// Zdroj vstupu (Přímý vstup, Google, Seznam, Facebook, …) – jen u první stránky návštěvy
  source    String?
  device    String?

  @@index([createdAt])
  @@index([visitor, createdAt])
  @@map("analytics_events")
}

/// Počítadla pro omezení počtu pokusů (přihlášení, formuláře). V DB, aby platila pro všechny instance serveru.
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime @map("reset_at")

  @@index([resetAt])
  @@map("rate_limits")
}
